    {"id": "P", "require_clear": false, "require_distractor_clear": false, "offset_z_m": 0.0},
    {"id": "J", "require_clear": true, "require_distractor_clear": false, "offset_z_m": 0.0},
    {"id": "C", "require_clear": true, "require_distractor_clear": true, "offset_z_m": 0.0}
