  "initial_offset_z_m": 0.045,
  "layout": {
    "id": "p0-dev-a-reused-geometry",
    "payload": "yellow",
    "support": "green",
    "blocker": "red",
    "distractor": "blue",
    "source_xy": [0.34, 0.15],
    "target_xy": [0.57, 0.15],
    "buffer_xy": [0.34, -0.15],
    "distractor_xy": [0.57, -0.15]
  },
  "candidates": [
    {"id": "B", "require_clear": false, "require_distractor_clear": false, "offset_z_m": 0.045},
